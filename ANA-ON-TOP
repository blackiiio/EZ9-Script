-- ====== ترتيب الأوامر (واحد من كل أمر بالدور) ======
local function BuildMessage(Commands, Target)
    local UniqueCmds = {}
    local Seen = {}
    for Cmd, Count in pairs(Commands) do
        if Count > 0 and not Seen[Cmd] then
            table.insert(UniqueCmds, Cmd)
            Seen[Cmd] = true
        end
    end
    
    local Parts = {}
    local Remaining = {}
    for Cmd, Count in pairs(Commands) do
        Remaining[Cmd] = Count
    end
    
    local Done = false
    while not Done do
        Done = true
        for _, Cmd in ipairs(UniqueCmds) do
            if Remaining[Cmd] and Remaining[Cmd] > 0 then
                table.insert(Parts, Prefix .. Cmd .. " " .. Target)
                Remaining[Cmd] = Remaining[Cmd] - 1
                Done = false
            end
        end
    end
    
    return table.concat(Parts, " ")
end

