local function SendHiddenMessage(Message)
    if HiddenSpam.Target == "" then return end
    task.spawn(function() pcall(function() CommandRemote:InvokeServer(Message) end) end)
    task.spawn(function()
        pcall(function()
            local HDClient = ReplicatedStorage:FindFirstChild("HDAdminHDClient")
            if HDClient and HDClient.Signals then HDClient.Signals.RequestCommandModification:InvokeServer(Message) end
        end)
    end)
    task.spawn(function()
        pcall(function()
            local CmdBar = ReplicatedStorage:FindFirstChild("cmdbar2")
            if CmdBar then CmdBar:FireServer(Message) end
        end)
    end)
end

function HiddenSpam:Start()
    if self.Thread then task.cancel(self.Thread) end
    self.Active = true
    self.Thread = task.spawn(function()
        while self.Active do
            local Message = BuildMessage(self.Commands, self.Target)
            if Message ~= "" then SendHiddenMessage(Message) end
            task.wait(self.Speed) -- سرعة قصوى معدلة مجدداً للاختراق
        end
    end)
end

