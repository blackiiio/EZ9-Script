-- ========== دوال مساعدة ==========
local function makeDraggable(obj)
    local dragging, startInput, startPos
    obj.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            startInput = input.Position
            startPos = obj.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    game:GetService("UserInputService").InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - startInput
            obj.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset+delta.X, startPos.Y.Scale, startPos.Y.Offset+delta.Y)
            startPos = obj.Position
            startInput = input.Position
        end
    end)
end

-- ========== دالة الإرسال عبر cmdbar و cmdbar2 ==========
local function sendViaCmdBar(msg)
    if msg == "" then return false end
    local success = false
    pcall(function()
        local rs = game:GetService("ReplicatedStorage")
        
        -- الطريقة 1: عبر HDAdmin
        local hd = rs:FindFirstChild("HDAdminHDClient")
        if hd and hd.Signals then
            hd.Signals.RequestCommandModification:InvokeServer(msg)
            success = true
        end
        
        -- الطريقة 2: عبر cmdbar
        local cmdbar = rs:FindFirstChild("CmdBar") or rs:FindFirstChild("cmdbar")
        if cmdbar then
            cmdbar:FireServer(msg)
            success = true
        end
        
        -- الطريقة 3: عبر cmdbar2
        local cmdbar2 = rs:FindFirstChild("CmdBar2") or rs:FindFirstChild("cmdbar2")
        if cmdbar2 then
            cmdbar2:FireServer(msg)
            success = true
        end
        
        -- الطريقة 4: عبر الشات العادي
        if not success then
            local chat = rs:FindFirstChild("DefaultChatSystemChatEvents")
            if chat and chat:FindFirstChild("SayMessageRequest") then
                chat.SayMessageRequest:FireServer(msg, "All")
                success = true
            end
        end
    end)
    return success
end

